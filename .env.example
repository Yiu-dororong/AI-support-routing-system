# Hugging Face token for faster downloads and avoiding rate limits
# HF_TOKEN="hf_..."

# Langfuse API credentials for optional execution tracing
# Obtain these from your Langfuse project settings dashboard (https://cloud.langfuse.com)
# LANGFUSE_PUBLIC_KEY="pk-lf-..."
# LANGFUSE_SECRET_KEY="sk-lf-..."
# LANGFUSE_HOST="https://cloud.langfuse.com" # Change to self-hosted URL if not using Langfuse Cloud

# OpenAI API key for RAGAS LLM-judged evaluation metrics (optional)
# Enables Faithfulness, Answer Relevance, Context Recall, and Context Precision scoring.
# A high-capability model (gpt-4o or equivalent) is required for reliable results.
# Without this key, RAGAS evaluation is disabled and only Hit@K runs.
# OPENAI_API_KEY="sk-..."

# Override the LLM judge model used by RAGAS (optional, default: gpt-4o)
# RAGAS_LLM_MODEL="gpt-4o"
# RAGAS_LLM_API_KEY=""
# RAGAS_LLM_BASE_URL=""
# RAGAS_BATCH_SIZE="5"
# RAGAS_BATCH_SLEEP="1"

# --- Notion API Configuration ---                                                                                                                                                                                                                                                                                                                          
# The official Notion server reads this variable to communicate with Notion                                                                                                                                                                                                                                                                                 
# NOTION_TOKEN="ntn_..."                                                                                                                                                                                                                                                                                                         
                                                                                                                                                                                                                                                                                                                                                            
# --- PostgreSQL Connection Configuration ---
# Set USE_LOCAL_DB="true" for local PostgreSQL container, or "false" for Supabase Cloud DB
USE_LOCAL_DB="true"

# Local PostgreSQL settings (used when USE_LOCAL_DB="true")
DB_HOST="127.0.0.1"
DB_PORT="5432"
DB_NAME="postgres"
DB_USER="postgres"
DB_PASSWORD="postgres"

# Supabase Cloud PostgreSQL settings (used when USE_LOCAL_DB="false")
# Copy the connection URI from Supabase (Settings -> Database -> Connection String)
SUPABASE_DB_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# --- LLM Inference Configuration (Local vs Cloud) ---
# Set USE_LOCAL_LLM="true" for local llama-server (Gemma-4 GGUF on CPU), or "false" for Cloud LLM
USE_LOCAL_LLM="true"

# Provider selection when USE_LOCAL_LLM="false": "gemini" | "openai"
LLM_PROVIDER="gemini"

# --- Google Gemini Cloud Settings (when LLM_PROVIDER="gemini") ---
# Obtain API key from Google AI Studio (https://aistudio.google.com)
GEMINI_API_KEY=""
# Separate models for Execution Planner (routing decision) and Response Synthesis (RAG output)
GEMINI_PLANNER_MODEL="gemma-4-31b-it"
GEMINI_SYNTHESIS_MODEL="gemini-3.1-flash-lite"

# --- Generic Cloud OpenAI / Custom Settings (when LLM_PROVIDER="openai") ---
LLM_CLOUD_BASE_URL="https://api.openai.com/v1"
LLM_CLOUD_API_KEY=""
LLM_CLOUD_PLANNER_MODEL="gpt-4o-mini"
LLM_CLOUD_SYNTHESIS_MODEL="gpt-4o-mini"